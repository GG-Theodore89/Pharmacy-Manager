<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<TabPane fx:id="authTabs"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.pharmacie.ui.controller.AuthController"
         tabClosingPolicy="UNAVAILABLE"
         prefWidth="440.0"
         prefHeight="520.0"
         style="-fx-font-family: 'Arial';">

    <tabs>
        <Tab fx:id="connexionTab" text="Connexion">
            <content>
                <VBox alignment="CENTER" spacing="14.0">
                    <padding>
                        <Insets top="35.0" right="40.0" bottom="35.0" left="40.0"/>
                    </padding>

                    <Label text="Bienvenue"
                           style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                    <Label text="Connectez-vous à votre compte"
                           style="-fx-text-fill: #666666;"/>

                    <VBox spacing="6.0">
                        <Label text="Adresse e-mail"/>
                        <TextField fx:id="connexionEmailField"
                                   promptText="exemple@email.com"
                                   maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6.0">
                        <Label text="Mot de passe"/>
                        <PasswordField fx:id="connexionMotDePasseField"
                                       promptText="Votre mot de passe"
                                       maxWidth="Infinity"
                                       onAction="#handleConnexion"/>
                    </VBox>

                    <Label fx:id="connexionErreurLabel"
                           wrapText="true"
                           maxWidth="Infinity"
                           style="-fx-text-fill: #c62828;"/>

                    <Button text="Se connecter"
                            onAction="#handleConnexion"
                            maxWidth="Infinity"
                            defaultButton="true"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </VBox>
            </content>
        </Tab>

        <Tab fx:id="inscriptionTab" text="Inscription">
            <content>
                <VBox alignment="CENTER" spacing="11.0">
                    <padding>
                        <Insets top="22.0" right="40.0" bottom="22.0" left="40.0"/>
                    </padding>

                    <Label text="Créer un compte"
                           style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                    <Label text="Remplissez les informations ci-dessous"
                           style="-fx-text-fill: #666666;"/>

                    <VBox spacing="5.0">
                        <Label text="Nom"/>
                        <TextField fx:id="nomField" promptText="Nom" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Prénom"/>
                        <TextField fx:id="prenomField" promptText="Prénom" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Adresse"/>
                        <TextField fx:id="adresseField" promptText="Adresse" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Adresse e-mail"/>
                        <TextField fx:id="inscriptionEmailField"
                                   promptText="exemple@email.com"
                                   maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="Mot de passe"/>
                        <PasswordField fx:id="inscriptionMotDePasseField"
                                       promptText="Choisissez un mot de passe"
                                       maxWidth="Infinity"
                                       onAction="#handleInscription"/>
                        <Label fx:id="inscriptionMotDePasseSuggestionLabel"
                               styleClass="field-caption"
                               wrapText="true"
                               maxWidth="Infinity"
                               visible="false"
                               managed="false"/>
                    </VBox>

                    <Label fx:id="inscriptionErreurLabel"
                           wrapText="true"
                           maxWidth="Infinity"
                           style="-fx-text-fill: #c62828;"/>

                    <Button text="Créer mon compte"
                            onAction="#handleInscription"
                            maxWidth="Infinity"
                            defaultButton="true"
                            style="-fx-background-color: #15803d; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </VBox>
            </content>
        </Tab>
    </tabs>
</TabPane>
