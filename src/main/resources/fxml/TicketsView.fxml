<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pharmacie.ui.controller.TicketsController"
            styleClass="page-root">

    <top>
        <VBox styleClass="page-header">
            <Label text="Tickets" styleClass="page-title"/>
            <Label text="Éditer le ticket d'une vente validée ou sélectionnée"
                   styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="18.0" styleClass="page-content">
                    <padding>
                        <Insets top="24.0" right="28.0" bottom="28.0" left="28.0"/>
                    </padding>

                    <VBox spacing="12.0" styleClass="card">
                        <Label text="Vente concernée" styleClass="card-heading"/>
                        <Label fx:id="venteLabel" styleClass="value-label" wrapText="true"/>
                        <HBox spacing="10.0">
                            <Button text="Générer le ticket" onAction="#handleGenererTicket"
                                    styleClass="primary-button"/>
                        </HBox>
                        <Label fx:id="messageLabel" styleClass="inline-message" wrapText="true"/>
                    </VBox>

                    <VBox spacing="12.0" styleClass="card">
                        <Label text="Aperçu du ticket" styleClass="card-heading"/>
                        <GridPane hgap="14.0" vgap="10.0" styleClass="form-grid">
                            <Label text="Numéro" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="numeroLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Date" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="dateLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Lignes" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="lignesLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" wrapText="true"/>
                            <Label text="Total" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="totalLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
