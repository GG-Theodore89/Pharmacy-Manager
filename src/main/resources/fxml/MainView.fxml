<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pharmacie.ui.controller.MainController"
            styleClass="app-root"
            prefWidth="1100.0"
            prefHeight="720.0">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="app-header">
                <padding>
                    <Insets top="18.0" right="32.0" bottom="18.0" left="32.0"/>
                </padding>

                <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                    <Label fx:id="welcomeLabel" text="Tableau de bord" styleClass="app-title"/>
                    <Label fx:id="subtitleLabel"
                           text="Personnel de la pharmacie — pharmacien ou préparateur"
                           styleClass="app-subtitle"/>
                </VBox>

                <Button text="Se déconnecter"
                        onAction="#handleDeconnexion"
                        styleClass="logout-button"/>
            </HBox>

            <MenuBar styleClass="main-menu">
                <menus>
                    <Menu text="Session">
                        <items>
                            <MenuItem text="Compte et accès" userData="COMPTE"
                                      onAction="#handleOpenPage"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Se déconnecter" onAction="#handleDeconnexion"/>
                        </items>
                    </Menu>
                    <Menu text="Catalogue">
                        <items>
                            <MenuItem text="Produits" userData="PRODUITS"
                                      onAction="#handleOpenPage"/>
                            <MenuItem text="Stock et lots" userData="STOCK"
                                      onAction="#handleOpenPage"/>
                        </items>
                    </Menu>
                    <Menu text="Opérations">
                        <items>
                            <MenuItem text="Approvisionnements" userData="APPROVISIONNEMENTS"
                                      onAction="#handleOpenPage"/>
                            <MenuItem text="Panier" userData="PANIER"
                                      onAction="#handleOpenPage"/>
                            <MenuItem text="Ventes" userData="VENTES"
                                      onAction="#handleOpenPage"/>
                            <MenuItem text="Tickets" userData="TICKETS"
                                      onAction="#handleOpenPage"/>
                        </items>
                    </Menu>
                    <Menu text="Relation client">
                        <items>
                            <MenuItem text="Clients" userData="CLIENTS"
                                      onAction="#handleOpenPage"/>
                        </items>
                    </Menu>
                    <Menu text="Pilotage">
                        <items>
                            <MenuItem text="Alertes" userData="ALERTES"
                                      onAction="#handleOpenPage"/>
                            <MenuItem text="Historique et bilans" userData="BILANS"
                                      onAction="#handleOpenPage"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="workspaceTabs"
                 styleClass="workspace-tabs"
                 tabClosingPolicy="SELECTED_TAB"/>
    </center>
</BorderPane>
