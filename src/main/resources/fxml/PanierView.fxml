<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pharmacie.ui.controller.PanierController"
            styleClass="page-root">

    <top>
        <VBox styleClass="page-header">
            <Label text="Panier" styleClass="page-title"/>
            <Label text="Préparer une vente : ajuster les quantités avant validation"
                   styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="18.0" styleClass="page-content">
                    <padding>
                        <Insets top="24.0" right="28.0" bottom="28.0" left="28.0"/>
                    </padding>

                    <VBox spacing="12.0" styleClass="card">
                        <Label text="Ajouter un produit" styleClass="card-heading"/>
                        <Label fx:id="utilisateurLabel" styleClass="value-label"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <TextField fx:id="rechercheField" promptText="Rechercher un produit"
                                       prefWidth="240.0"/>
                            <Button text="Rechercher" onAction="#handleRechercher"
                                    styleClass="secondary-button"/>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <ComboBox fx:id="produitsCombo" promptText="Produit"
                                      prefWidth="300.0"/>
                            <Label text="Quantité"/>
                            <TextField fx:id="quantiteField" promptText="1" prefWidth="80.0"/>
                            <Button text="Ajouter au panier" onAction="#handleAjouter"
                                    styleClass="primary-button"/>
                        </HBox>
                        <Label fx:id="messageLabel" styleClass="inline-message" wrapText="true"/>
                    </VBox>

                    <VBox spacing="12.0" styleClass="card">
                        <Label text="Contenu du panier" styleClass="card-heading"/>
                        <TableView fx:id="panierTable" prefHeight="260.0">
                            <columns>
                                <TableColumn fx:id="produitCol" text="Produit" prefWidth="260.0"/>
                                <TableColumn fx:id="quantiteCol" text="Quantité" prefWidth="100.0"/>
                                <TableColumn fx:id="prixCol" text="Prix unitaire" prefWidth="130.0"/>
                                <TableColumn fx:id="sousTotalCol" text="Sous-total" prefWidth="130.0"/>
                            </columns>
                            <placeholder>
                                <Label text="Le panier est vide"/>
                            </placeholder>
                        </TableView>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Nouvelle quantité"/>
                            <TextField fx:id="nouvelleQuantiteField" promptText="1" prefWidth="80.0"/>
                            <Button text="Modifier la quantité" onAction="#handleModifierQuantite"
                                    styleClass="secondary-button"/>
                            <Button text="Retirer du panier" onAction="#handleRetirer"
                                    styleClass="danger-button"/>
                            <Button text="Vider le panier" onAction="#handleVider"
                                    styleClass="danger-button"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Label text="Total du panier" styleClass="field-caption"/>
                            <Label fx:id="totalLabel" text="0,00" styleClass="total-label"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
