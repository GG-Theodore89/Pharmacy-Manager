<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pharmacie.ui.controller.CompteController"
            styleClass="page-root">

    <top>
        <VBox styleClass="page-header">
            <Label text="Compte et accès" styleClass="page-title"/>
            <Label text="Gérer la session en cours et créer un nouvel accès personnel"
                   styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="18.0" styleClass="page-content">
                    <padding>
                        <Insets top="24.0" right="28.0" bottom="28.0" left="28.0"/>
                    </padding>

                    <VBox spacing="12.0" styleClass="card">
                        <Label text="Session en cours" styleClass="card-heading"/>
                        <Label fx:id="sessionLabel" styleClass="value-label" wrapText="true"/>
                        <HBox spacing="10.0">
                            <Button text="Se déconnecter" onAction="#handleDeconnexion"
                                    styleClass="danger-button"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="14.0" styleClass="card">
                        <Label text="Créer un compte" styleClass="card-heading"/>

                        <GridPane hgap="14.0" vgap="10.0" styleClass="form-grid">
                            <Label text="Nom" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="nomField" promptText="Nom"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Prénom" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="prenomField" promptText="Prénom"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Adresse" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <TextField fx:id="adresseField" promptText="Adresse"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="E-mail" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="emailField" promptText="nom@pharmacie.fr"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Mot de passe" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <PasswordField fx:id="motDePasseField" promptText="Mot de passe"
                                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            <Label fx:id="motDePasseSuggestionLabel"
                                   styleClass="field-caption"
                                   wrapText="true"
                                   visible="false"
                                   managed="false"
                                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        </GridPane>

                        <Label fx:id="messageLabel" styleClass="inline-message" wrapText="true"/>
                        <HBox spacing="10.0">
                            <Button text="Créer le compte" onAction="#handleInscrire"
                                    styleClass="primary-button"/>
                            <Button text="Effacer" onAction="#handleEffacer"
                                    styleClass="secondary-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
