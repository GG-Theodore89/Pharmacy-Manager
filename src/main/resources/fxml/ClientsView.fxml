<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pharmacie.ui.controller.ClientsController"
            styleClass="page-root">

    <top>
        <VBox styleClass="page-header">
            <Label text="Clients" styleClass="page-title"/>
            <Label text="Fiches clients, recherche, historique des ventes et gestion du statut"
                   styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.3" styleClass="selection-split">
            <items>
                <VBox spacing="10.0" styleClass="selection-pane">
                    <padding>
                        <Insets top="20.0" right="14.0" bottom="20.0" left="20.0"/>
                    </padding>
                    <Label text="Rechercher un client" styleClass="card-heading"/>
                    <TextField fx:id="rechercheField" promptText="Nom, prénom, e-mail..."/>
                    <Button text="Rechercher" onAction="#handleRechercher"
                            styleClass="primary-button"/>
                    <TreeView fx:id="arbreClients" VBox.vgrow="ALWAYS"
                              styleClass="selection-tree"/>
                </VBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                    <content>
                        <VBox spacing="18.0" styleClass="page-content">
                            <padding>
                                <Insets top="24.0" right="28.0" bottom="28.0" left="28.0"/>
                            </padding>

                            <VBox spacing="14.0" styleClass="card">
                                <Label text="Fiche client" styleClass="card-heading"/>
                                <GridPane hgap="14.0" vgap="10.0" styleClass="form-grid">
                                    <Label text="Nom" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <TextField fx:id="nomField" promptText="Nom"
                                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label text="Prénom" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                    <TextField fx:id="prenomField" promptText="Prénom"
                                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                                    <Label text="Adresse" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <TextField fx:id="adresseField" promptText="Adresse"
                                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label text="Téléphone" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                    <TextField fx:id="telephoneField" promptText="Téléphone"
                                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                    <Label text="E-mail" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                    <TextField fx:id="emailField" promptText="E-mail"
                                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                    <Label text="Ordonnance" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                    <TextField fx:id="ordonanceField" promptText="Information"
                                               GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                </GridPane>
                                <HBox spacing="18.0">
                                    <CheckBox fx:id="actifCheckBox" text="Client actif"/>
                                </HBox>
                                <HBox spacing="10.0">
                                    <Button text="Ajouter le client" onAction="#handleAjouter"
                                            styleClass="primary-button"/>
                                    <Button text="Effacer" onAction="#handleEffacer"
                                            styleClass="secondary-button"/>
                                </HBox>
                                <Label fx:id="messageLabel" styleClass="inline-message" wrapText="true"/>
                            </VBox>

                            <VBox spacing="12.0" styleClass="card">
                                <Label text="Actions sur le client sélectionné" styleClass="card-heading"/>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <Label text="Identifiant"/>
                                    <TextField fx:id="idField" editable="false"
                                               promptText="Sélectionnez dans l'arbre"
                                               prefWidth="150.0" styleClass="id-field"/>
                                    <Button text="Modifier" onAction="#handleModifier"
                                            styleClass="secondary-button"/>
                                    <Button text="Désactiver" onAction="#handleDesactiver"
                                            styleClass="secondary-button"/>
                                    <Button text="Supprimer" onAction="#handleSupprimer"
                                            styleClass="danger-button"/>
                                    <Button text="Historique des ventes" onAction="#handleHistoriqueVentes"
                                            styleClass="secondary-button"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="12.0" styleClass="card">
                                <Label text="Résultats" styleClass="card-heading"/>
                                <TableView fx:id="clientsTable" prefHeight="230.0">
                                    <columns>
                                        <TableColumn fx:id="idCol" text="N°" prefWidth="60.0"/>
                                        <TableColumn fx:id="nomCol" text="Nom" prefWidth="140.0"/>
                                        <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="140.0"/>
                                        <TableColumn fx:id="adresseCol" text="Adresse" prefWidth="200.0"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="Aucun client affiché"/>
                                    </placeholder>
                                </TableView>
                                <Label text="Ventes du client" styleClass="field-caption"/>
                                <ListView fx:id="historiqueList" prefHeight="130.0"/>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>
